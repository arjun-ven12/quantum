    "@xyflow/react": "^12.9.0",
    "dexie": "^4.2.1",
    "dexie-react-hooks": "^4.4.0",
    "katex": "^0.16.22",
    "lucide-react": "^0.468.0",
    "motion": "^12.23.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "recharts": "^3.2.0",
    "rehype-katex": "^7.0.1",
